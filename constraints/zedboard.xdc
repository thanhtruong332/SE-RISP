# ===================================================================
# ZEDBOARD CONSTRAINT FILE CHO SE-RISSP (SOC MEDICAL IOT - 40MHz)
# ===================================================================

# -------------------------------------------------------------------
# 1. System Clock (Nguồn 100MHz từ board, cấp vào clk_wiz ra 40MHz)
# -------------------------------------------------------------------
set_property PACKAGE_PIN Y9 [get_ports clk_in1_0]
set_property IOSTANDARD LVCMOS33 [get_ports clk_in1_0]

# -------------------------------------------------------------------
# 2. Reset Buttons
# -------------------------------------------------------------------
set_property PACKAGE_PIN N15 [get_ports reset_0]
set_property IOSTANDARD LVCMOS25 [get_ports reset_0]

set_property PACKAGE_PIN R16 [get_ports ext_reset_in_0]
set_property IOSTANDARD LVCMOS25 [get_ports ext_reset_in_0]

# -------------------------------------------------------------------
# 3. UART -> PMOD JA (Đã fix đúng chiều TX/RX cho CP2102)
# -------------------------------------------------------------------
# tx_0 (SoC truyền ra) nối ra JA1 (Y11) -> Cắm RXD của CP2102 vào đây
set_property PACKAGE_PIN Y11 [get_ports tx_0]
set_property IOSTANDARD LVCMOS33 [get_ports tx_0]

# rx_0 (SoC nhận vào) nối ra JA2 (AA11) -> Cắm TXD của CP2102 vào đây
set_property PACKAGE_PIN AA11 [get_ports rx_0]
set_property IOSTANDARD LVCMOS33 [get_ports rx_0]

# -------------------------------------------------------------------
# 4. False Paths & Multicycle Paths (Tối ưu Timing)
# -------------------------------------------------------------------
set_false_path -from [get_ports reset_0]
set_false_path -from [get_ports ext_reset_in_0]

set _xlnx_shared_i0 [get_cells {test01_i/AES_hardware_final_0/inst/aes_inst/key_reg_reg[*]}]
set _xlnx_shared_i1 [get_cells {test01_i/AES_hardware_final_0/inst/aes_inst/aes_core_inst/state_reg_reg[*]}]
set_multicycle_path -setup -from $_xlnx_shared_i0 -to $_xlnx_shared_i1 2
set_multicycle_path -hold -from $_xlnx_shared_i0 -to $_xlnx_shared_i1 1

set_operating_conditions -grade extended

create_debug_core u_ila_0 ila
set_property ALL_PROBE_SAME_MU true [get_debug_cores u_ila_0]
set_property ALL_PROBE_SAME_MU_CNT 1 [get_debug_cores u_ila_0]
set_property C_ADV_TRIGGER false [get_debug_cores u_ila_0]
set_property C_DATA_DEPTH 1024 [get_debug_cores u_ila_0]
set_property C_EN_STRG_QUAL false [get_debug_cores u_ila_0]
set_property C_INPUT_PIPE_STAGES 0 [get_debug_cores u_ila_0]
set_property C_TRIGIN_EN false [get_debug_cores u_ila_0]
set_property C_TRIGOUT_EN false [get_debug_cores u_ila_0]
set_property port_width 1 [get_debug_ports u_ila_0/clk]
connect_debug_port u_ila_0/clk [get_nets [list test01_i/clk_wiz_0/inst/clk_out1]]
set_property PROBE_TYPE DATA_AND_TRIGGER [get_debug_ports u_ila_0/probe0]
set_property port_width 128 [get_debug_ports u_ila_0/probe0]
connect_debug_port u_ila_0/probe0 [get_nets [list {test01_i/AES_hardware_final_0/inst/aes_inst/ILA_CORE_RAW_OUT[0]} {test01_i/AES_hardware_final_0/inst/aes_inst/ILA_CORE_RAW_OUT[1]} {test01_i/AES_hardware_final_0/inst/aes_inst/ILA_CORE_RAW_OUT[2]} {test01_i/AES_hardware_final_0/inst/aes_inst/ILA_CORE_RAW_OUT[3]} {test01_i/AES_hardware_final_0/inst/aes_inst/ILA_CORE_RAW_OUT[4]} {test01_i/AES_hardware_final_0/inst/aes_inst/ILA_CORE_RAW_OUT[5]} {test01_i/AES_hardware_final_0/inst/aes_inst/ILA_CORE_RAW_OUT[6]} {test01_i/AES_hardware_final_0/inst/aes_inst/ILA_CORE_RAW_OUT[7]} {test01_i/AES_hardware_final_0/inst/aes_inst/ILA_CORE_RAW_OUT[8]} {test01_i/AES_hardware_final_0/inst/aes_inst/ILA_CORE_RAW_OUT[9]} {test01_i/AES_hardware_final_0/inst/aes_inst/ILA_CORE_RAW_OUT[10]} {test01_i/AES_hardware_final_0/inst/aes_inst/ILA_CORE_RAW_OUT[11]} {test01_i/AES_hardware_final_0/inst/aes_inst/ILA_CORE_RAW_OUT[12]} {test01_i/AES_hardware_final_0/inst/aes_inst/ILA_CORE_RAW_OUT[13]} {test01_i/AES_hardware_final_0/inst/aes_inst/ILA_CORE_RAW_OUT[14]} {test01_i/AES_hardware_final_0/inst/aes_inst/ILA_CORE_RAW_OUT[15]} {test01_i/AES_hardware_final_0/inst/aes_inst/ILA_CORE_RAW_OUT[16]} {test01_i/AES_hardware_final_0/inst/aes_inst/ILA_CORE_RAW_OUT[17]} {test01_i/AES_hardware_final_0/inst/aes_inst/ILA_CORE_RAW_OUT[18]} {test01_i/AES_hardware_final_0/inst/aes_inst/ILA_CORE_RAW_OUT[19]} {test01_i/AES_hardware_final_0/inst/aes_inst/ILA_CORE_RAW_OUT[20]} {test01_i/AES_hardware_final_0/inst/aes_inst/ILA_CORE_RAW_OUT[21]} {test01_i/AES_hardware_final_0/inst/aes_inst/ILA_CORE_RAW_OUT[22]} {test01_i/AES_hardware_final_0/inst/aes_inst/ILA_CORE_RAW_OUT[23]} {test01_i/AES_hardware_final_0/inst/aes_inst/ILA_CORE_RAW_OUT[24]} {test01_i/AES_hardware_final_0/inst/aes_inst/ILA_CORE_RAW_OUT[25]} {test01_i/AES_hardware_final_0/inst/aes_inst/ILA_CORE_RAW_OUT[26]} {test01_i/AES_hardware_final_0/inst/aes_inst/ILA_CORE_RAW_OUT[27]} {test01_i/AES_hardware_final_0/inst/aes_inst/ILA_CORE_RAW_OUT[28]} {test01_i/AES_har